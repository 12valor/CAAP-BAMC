# Public values from Supabase Dashboard > Project Settings > API.
# The publishable key is safe for browser use when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only values. Never prefix these with NEXT_PUBLIC_ and never commit
# real values. Create the secret key in Supabase Settings > API Keys.
SUPABASE_SECRET_KEY=sb_secret_your-server-key
AUTH_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# One-time first-administrator bootstrap inputs. The bootstrap command generates
# the password and displays it once; do not add a plaintext password here.
BOOTSTRAP_ADMIN_USERNAME=initial.admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Initial Administrator

# Playwright authorization tests use synthetic, isolated accounts only. Do not
# place production employee credentials in automated test configuration.
# E2E_ADMIN_USERNAME=
# E2E_ADMIN_PASSWORD=
# E2E_EMPLOYEE_A_USERNAME=
# E2E_EMPLOYEE_A_PASSWORD=
# E2E_EMPLOYEE_A_ID=
# E2E_EMPLOYEE_B_ID=

# Never place a Supabase secret key or service-role key in NEXT_PUBLIC_* variables.
