# Public values from Supabase Dashboard > Project Settings > API.
# The publishable key is safe for browser use when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Never place a Supabase secret key or service-role key in NEXT_PUBLIC_* variables.
